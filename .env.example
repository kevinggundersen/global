# Descriptive User-Agent sent by Nominatim search (required by OSM policy).
# Include contact info so the OSM operations team can reach you if abuse is detected.
VITE_NOMINATIM_USER_AGENT="global-globe/0.1 (contact: you@example.com)"

# Optional: override the Nominatim endpoint (e.g. a self-hosted mirror).
# VITE_NOMINATIM_ENDPOINT=https://nominatim.openstreetmap.org
